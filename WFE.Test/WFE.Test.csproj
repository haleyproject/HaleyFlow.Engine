<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HaleyProject Condition="'$(HaleyProject)' == ''">$(MSBuildProjectDirectory)\..\..</HaleyProject>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\HaleyProject\HaleyProject.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Source.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Version.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Paths.Props" />
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <ProjectReference Include="..\HaleyFlowEngine\HaleyFlowEngine.csproj" />
    <ProjectReference Include="..\..\HaleyFlow.Consumer\HaleyFlowConsumer\HaleyFlowConsumer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\_RESOURCES\lc_state.sql" Link="Sql\engine.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\HaleyFlow.Consumer\__RESOURCES\consumer.sql" Link="Sql\consumer.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\_RESOURCES\migrations\20260919_protocol_recovery.sql" Link="Sql\upgrade.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
